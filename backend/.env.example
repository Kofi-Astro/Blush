# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Supabase → Project Settings → Database → Connection string → "URI"
# (Use the direct connection, port 5432, for a long-running server like this one.
# If you ever deploy to a serverless platform, switch to the "Transaction pooler"
# connection string on port 6543 instead.)
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
SUPABASE_MEDIA_BUCKET=media

# Single admin account for the dashboard.
# Generate the hash with: python scripts/hash_password.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Any long random string — e.g. `python -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=720

# Comma-separated origins allowed to call the API from a browser.
# Include admin.blushcloset.xyz if/when the admin dashboard is deployed
# standalone (e.g. on Cloudflare Pages) rather than served by this backend's
# own /admin mount, since it then becomes a cross-origin request.
ALLOWED_ORIGINS=https://blushcloset.xyz,https://admin.blushcloset.xyz,http://localhost:5500,http://127.0.0.1:5500
